// prisma/schema/membros.prisma
// 🔐 (5 out 2026) ÁREA DE MEMBROS (PA ELITE TEAM) — contas de quem compra produtos digitais pela página de vendas.
// Ficam SEPARADAS da tabela User (alunos e coaches): quem vem do tráfego pago não pode entrar no painel dos coaches, nos limites de plano,
// nas notificações nem nas cobranças. O que cada membro tem liberado NÃO é gravado aqui: vem das vendas pagas (ProdutoVenda) pelo e-mail,
// então comprar de novo ou receber um bônus não precisa mexer nesta tabela.
//
// Login sem senha: o membro recebe um código de 6 dígitos (ou um link, no e-mail da compra) e troca por uma sessão.
// Nenhum código, link ou sessão é guardado em texto puro: só o HMAC deles.

model Membro {
  id            String    @id @default(uuid())
  email         String    @unique // sempre minúsculo e sem espaços (ver normalizeEmail em lib/membros.ts)
  nome          String?
  telefone      String?
  origem        String    @default("COMPRA") // COMPRA | IMPORTACAO
  ultimoAcesso  DateTime?
  createdAt     DateTime  @default(now())

  codigos       MembroCodigo[]
  sessoes       MembroSessao[]
  registros     MembroRegistro[]
  habitos       MembroHabito[]
  medidas       MembroMedida[]
  fotos         MembroFoto[]
}

model MembroCodigo {
  id          String    @id @default(uuid())
  membroId    String
  membro      Membro    @relation(fields: [membroId], references: [id], onDelete: Cascade)

  tipo        String    // CODIGO (6 dígitos, vale 10 minutos) | LINK (enviado no e-mail da compra, vale 14 dias)
  hash        String    @unique
  tentativas  Int       @default(0) // erros de digitação: depois de 5 o código morre
  expiraEm    DateTime
  usadoEm     DateTime?
  createdAt   DateTime  @default(now())

  @@index([membroId, tipo])
}

model MembroSessao {
  id          String    @id @default(uuid())
  membroId    String
  membro      Membro    @relation(fields: [membroId], references: [id], onDelete: Cascade)

  tokenHash   String    @unique
  userAgent   String?
  expiraEm    DateTime
  ultimoUso   DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([membroId])
}

// 🏋️ (out 2026) ÁREA DE MEMBROS DO PRODUTO: tudo que a pessoa marca e anota dentro de um produto digital. Fica no servidor, então ela continua de onde parou ao trocar de celular.
// O conteúdo (treino, guias, receitas...) vem do produto (ProdutoDigital.treinoAvulsoId e membrosAbas); aqui só ficam os dados DA PESSOA.
// `semana` começa em 1 (a contar do dia do pagamento). Tabelas novas: só adicionam (rodar `npx prisma db push` ANTES de publicar o backend).

// Marcação e carga de cada exercício, por semana. `chave` é o código estável do exercício no treino (dia + exercício do catálogo + ocorrência; não muda
// quando o coach reordena ou edita o treino). `carga` é o peso (kg) da última série de trabalho. `feitoEm` e `cargaEm` alimentam os hábitos automáticos.
model MembroRegistro {
  id          String    @id @default(uuid())
  membroId    String
  membro      Membro    @relation(fields: [membroId], references: [id], onDelete: Cascade)

  produtoId   String
  semana      Int
  chave       String

  feito       Boolean   @default(false)
  carga       Float?
  feitoEm     DateTime?
  cargaEm     DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([membroId, produtoId, semana, chave])
  @@index([membroId, produtoId])
}

// Checklist de hábitos: uma linha por quadradinho marcado (desmarcar apaga a linha). `dia` é 0..6 dentro da semana (0 = o dia do pagamento).
model MembroHabito {
  id          String    @id @default(uuid())
  membroId    String
  membro      Membro    @relation(fields: [membroId], references: [id], onDelete: Cascade)

  produtoId   String
  semana      Int
  dia         Int
  habito      String
  createdAt   DateTime  @default(now())

  @@unique([membroId, produtoId, semana, dia, habito])
  @@index([membroId, produtoId])
}

// Ficha de medidas: uma linha por momento (início, semana 4, semana 8...). `valores` = { campo: número }.
model MembroMedida {
  id          String    @id @default(uuid())
  membroId    String
  membro      Membro    @relation(fields: [membroId], references: [id], onDelete: Cascade)

  produtoId   String
  momento     String
  data        String?   // AAAA-MM-DD, o dia em que a pessoa se mediu
  valores     Json
  updatedAt   DateTime  @updatedAt

  @@unique([membroId, produtoId, momento])
  @@index([membroId, produtoId])
}

// Fotos de evolução (PRIVADAS: só a própria pessoa as vê, pelo site de membros, com a sessão dela). A foto fica no banco, já reduzida pelo navegador (JPEG).
model MembroFoto {
  id          String    @id @default(uuid())
  membroId    String
  membro      Membro    @relation(fields: [membroId], references: [id], onDelete: Cascade)

  produtoId   String
  momento     String
  pose        String
  bytes       Bytes
  tamanho     Int
  createdAt   DateTime  @default(now())

  @@unique([membroId, produtoId, momento, pose])
  @@index([membroId, produtoId])
}
