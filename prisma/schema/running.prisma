// prisma/schema/running.prisma

model RunningAnamnese {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String   @unique @default(uuid())
  filled    Boolean  @default(false)
  filledAt  DateTime?

  runningExperience   String?  
  timeStopped         String?  
  maxDistanceBefore   String?  
  weeklyFrequencyNow  String?  
  completedRaces      Boolean  @default(false)
  racesDescription    String?  

  canWalk30min        Boolean  @default(false)
  canJog5min          Boolean  @default(false)
  breathingDifficulty String?  
  fitnessLevel        Int?     

  injuries            String[] @default([]) 
  heartCondition      Boolean  @default(false)
  jointIssues         Boolean  @default(false)
  medications         String?
  medicalClearance    String?  

  runningGoal         String?  
  goalDeadline        String?  
  previousFailures    String?  @db.Text

  availableDays       String[] @default([]) 
  preferredTime       String?  
  trainingLocation    String?  
  hasProperShoes      String?  

  weight              Float?
  height              Float?
  bodyPainDuringWalk  String?  @db.Text
  sleepQuality        String?  

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RunningProtocol {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String   @default("Protocolo 5K")
  isActive    Boolean  @default(true)
  startDate   DateTime @default(now())

  // 🏃 (6 out 2026) Tipo do protocolo (5K, 10K, 21K ou 42K) e dias de treino escolhidos (SEG…DOM, na ordem leve / qualidade / longão).
  protocolType String  @default("5K")
  trainingDays String[] @default([])

  startBlock  Int      @default(1)  
  startWeek   Int      @default(1)  

  // 🏃 Andamento por DESEMPENHO (antes a semana só andava com o calendário): semana atual, quando ela abriu, quando o protocolo foi concluído e o recado
  // que explica a última mudança ("semana repetida por esforço alto", "voltamos uma semana"). Nulo = protocolo antigo (usa o calendário e passa a gravar sozinho).
  currentWeek     Int?
  weekOpenedAt    DateTime?
  completedAt     DateTime?
  lastRepeatWeek  Int?
  progressNote    String?   @db.Text

  customNotes       String?  @db.Text  
  customSpeeds      Json?              
  adaptations       String?  @db.Text  

  generatedByAI     Boolean  @default(false)
  aiPromptSnapshot  String?  @db.Text  

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  logs        RunningLog[]
}

model RunningLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 🏃 Opcional: a corrida avulsa de quem não tem protocolo ativo não tem protocolo (antes o campo era obrigatório e essa corrida não salvava).
  protocolId  String?
  protocol    RunningProtocol? @relation(fields: [protocolId], references: [id], onDelete: Cascade)

  week        Int              
  block       Int              
  sessionDay  String           

  date             DateTime @default(now())
  durationMinutes  Int?
  distanceKm       Float?
  avgPace          String?  
  notes            String?  @db.Text

  rpe              Int?     

  createdAt   DateTime @default(now())
}