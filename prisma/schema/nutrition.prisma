// prisma/schema/nutrition.prisma

model Diet {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  pdfUrl        String?

  name          String    @default("Plano Alimentar")
  goal          String?

  totalKcal     Float?
  totalProtein  Float?
  totalCarbs    Float?
  totalFats     Float?

  waterIntake   String?
  freeMeal      String?
  generalNotes  String?   @db.Text

  isActive      Boolean   @default(true)

  // 🔥 ESTRATÉGIAS TEMPORÁRIAS
  isStrategy        Boolean   @default(false)
  strategyName      String?
  strategyActive    Boolean   @default(false)
  strategyStartDate DateTime?
  strategyEndDate   DateTime?
  // 🔥 NOVO: controla se essa estratégia substitui totalmente a dieta base (aluno só vê ela)
  // ou fica como opção alternativa (aluno escolhe entre ela e a base). Default = aluno escolhe.
  strategyExclusive Boolean   @default(false)

  meals         Meal[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Meal {
  id        String     @id @default(uuid())
  dietId    String
  diet      Diet       @relation(fields: [dietId], references: [id], onDelete: Cascade)
  name      String
  time      String?
  order     Int        @default(0)
  notes     String?    @db.Text
  dayType   String     @default("TREINO")

  alternativeGroupId String?
  isMainVersion      Boolean    @default(true)
  alternativeLabel   String?

  items     FoodItem[]
}

model FoodItem {
  id                  String   @id @default(uuid())
  mealId              String
  meal                Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)

  name                String
  amount              Float
  unit                String

  protein             Float?
  carbs               Float?
  fats                Float?
  calories            Float?

  substitutionGroupId String?

  // 🥄 (30 set 2026) Metadados do item salvos à parte (foodId do catálogo + medidas vigentes
  // quando a dieta foi salva). É uma relação VIRTUAL: não adiciona coluna nenhuma em FoodItem,
  // então as leituras de dieta que já existem não dependem de a tabela nova existir.
  meta                FoodItemMeta?
}

// 🥄 (30 set 2026) MEDIDAS CASEIRAS por alimento -- quanto pesa (ou mede) UMA colher de sopa, UMA
// escumadeira, UM bife médio... daquele alimento. Antes as medidas ficavam num arquivo dentro do
// app (foodPortions.js), só pra ~100 alimentos e sem como o coach/nutri cadastrar as dele.
//   scope  = 'GLOBAL' (vale pra todos) ou o teamId de quem ajustou (sobrepõe SÓ pra ele; um coach
//            ou nutri nunca altera a medida do outro).
//   source = MANUAL (arquivo antigo do app / time master), IBGE (Tabela de Medidas Referidas da POF
//            2008-2009, depois de revisada) ou COACH (ajuste do profissional).
// Precedência na hora de usar: COACH do time > GLOBAL manual > GLOBAL IBGE. Ver lib/foodMeasures.ts.
model FoodPortion {
  id            String   @id @default(uuid())
  foodId        String
  scope         String   @default("GLOBAL")
  unit          String
  grams         Float
  isDefault     Boolean  @default(false)
  defaultAmount Float?
  source        String   @default("MANUAL")
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([foodId, scope, unit])
  @@index([foodId])
  @@index([scope])
}

// 🎯 (30 set 2026) Metas do nutricionista/coach para UM aluno (equação de TMB, fator de atividade, ajuste do
// objetivo, macros por g/kg ou %, kcal manual por dia). Uma linha por aluno; vale para a dieta base e
// para as estratégias. Tabela nova e independente: sem ela o app usa o cálculo padrão.
model StudentDietTargets {
  userId      String   @id
  config      Json
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 🪪 (30 set 2026) Título e registro profissional de quem assina os documentos (ex.: "Nutricionista" + "CRN-3 12345",
// "Educador Físico" + "CREF 012345-G/SP"). Uma linha por profissional; aparece no fim do PDF da dieta quando ele
// marca "assinar". Tabela nova e independente: sem ela o PDF sai sem assinatura, como sempre foi.
model ProfessionalProfile {
  userId    String   @id
  title     String?
  registry  String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// 🏷️ (30 set 2026) Nomes das abas de dia da dieta (Treino, Treino + Cardio, Só Cardio, Descanso) que o coach
// personaliza ("Opção 1", "Carbo Alto", "Sábado"...). Uma linha por dieta (base ou estratégia). Só os NOMES: os
// tipos internos de dia não mudam, então o app do aluno antigo continua funcionando com os nomes de sempre.
model DietDayScheme {
  dietId    String   @id
  scheme    Json
  updatedAt DateTime @updatedAt
}

model FoodItemMeta {
  foodItemId String   @id
  foodItem   FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  foodId     String?
  portions   Json?
  createdAt  DateTime @default(now())

  @@index([foodId])
}

model SubstitutionGroup {
  id          String   @id @default(uuid())
  name        String
  description String?
  teamId      String
  createdAt   DateTime @default(now())

  members SubstitutionGroupMember[]
}

model SubstitutionGroupMember {
  id      String @id @default(uuid())
  groupId String
  foodId  String

  group SubstitutionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, foodId])
  @@index([foodId])
}

model Food {
  id         String   @id @default(uuid())
  source     String
  externalId String?
  teamId     String?

  name        String
  category    String
  subcategory String?
  baseUnit    String   @default("g")

  kcal       Float
  protein    Float
  carbs      Float
  fat        Float
  fiber      Float?

  isLactoseFree     Boolean? @default(false)
  equivalenceFactor Float?   @default(1)
  conversionFactor  Float?   @default(1)
  isFavorite        Boolean  @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([source, externalId])
  @@index([teamId])
  @@index([category])
  @@index([name])
}

model DietTemplate {
  id        String   @id @default(uuid())
  name      String
  goal      String?
  totalKcal Float?
  meals     Json
  createdAt DateTime @default(now())
}

model MealTemplate {
  id        String   @id @default(uuid())
  name      String
  category  String?
  items     Json
  createdAt DateTime @default(now())
}

// 🔥 NOVO: atalhos de observação de refeição salvos pelo coach, pra reusar
// em qualquer dieta depois (além dos 6 sugeridos fixos no app).
model NoteSnippet {
  id        String   @id @default(uuid())
  text      String   @db.Text
  createdAt DateTime @default(now())
}

// 🔥 (18 set 2026) Opções de refeição livre cadastradas pelo coach — substitui
// a lista fixa de 5 sugestões (Pizza, Hambúrguer, Sushi, Massa, Doce) que
// antes estava direto no código do app. Mesmo padrão de escopo do
// SubstitutionGroup: teamId = coachId (ou "MASTER_TEAM" se for Paulo/Adri),
// então o coach cadastra uma vez e a lista já aparece pra todos os alunos
// dele. De propósito SEM dado nutricional (kcal/macros) — é uma sugestão
// descritiva pro momento de "válvula de escape", não uma refeição calculada
// como as da Mesa de Operações.
model FreeMealOption {
  id        String   @id @default(uuid())
  teamId    String

  icon      String   @default("🍽️")
  title     String
  desc      String?  @db.Text
  avoid     String?  @db.Text // "Evite: ..." — opcional

  order     Int      @default(0)
  isActive  Boolean  @default(true)

  // 🔥 (18 set 2026) Marca essa opção como "dia livre total" (ex: fim de
  // semana liberado, comemoração) — quando o aluno seleciona uma opção com
  // hideRules=true, o app esconde o bloco fixo "AS REGRAS DO JOGO" (regra do
  // merecimento, uma refeição só etc.), já que ele contradiz a liberação.
  hideRules Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
}

// 🔥 Diário alimentar por refeição (16 set 2026) — registro opcional, um toque
// só, sem obrigar nada. status:
//   'SEGUIU'     → aluno marcou que comeu a refeição como prescrita
//   'SUBSTITUIU' → aluno trocou (substitutionLabel guarda qual versão/o que)
//   'PULOU'      → aluno marcou que pulou a refeição
//   'LIVRE'      → registro da refeição livre (mealId = 'refeicao_livre')
// Ausência de registro pra uma refeição/dia não é "PULOU" — é simplesmente
// nenhuma linha aqui, o que também é sinal útil pro nutricionista (silêncio).
// Upsert por [userId, date, mealId] — reabrir e trocar a marcação atualiza,
// não duplica.
model DietMealLog {
  id      String @id @default(uuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachId String? // denormalizado pra consulta de aderência sem precisar de join

  date     String // "YYYY-MM-DD", mesmo padrão do DailyCheckin
  mealId   String // meal.id da Diet ativa, ou "refeicao_livre"
  mealName String

  status            String
  substitutionLabel String?
  note              String? @db.Text
  photoUrl          String? // 🔥 (17 set 2026) foto opcional da refeição livre — comprimida antes de subir pro R2, sem thumb separado (custo baixo de propósito)

  // 🔥 (18 set 2026) Refeição livre com opção do coach — freeMealOptionId é
  // uma referência solta (sem @relation) pro FreeMealOption marcado; guardamos
  // também o título no momento do registro (freeMealOptionLabel) pra não
  // quebrar o histórico se o coach editar/apagar a opção depois. Os dois
  // ficam null quando o aluno descreveu por texto livre em vez de marcar uma
  // opção cadastrada.
  freeMealOptionId    String?
  freeMealOptionLabel String?

  // 🔥 Observação do coach sobre esse registro específico (ex: "combinado,
  // mas evite repetir semana que vem") — editável na tela de dieta do coach.
  coachObservation String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date, mealId])
  @@index([coachId, date])
}

model DietFeedback {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  satiety          String?
  difficulty       String?
  requestedChanges String?  @db.Text
  read             Boolean  @default(false)
  createdAt        DateTime @default(now())
}
