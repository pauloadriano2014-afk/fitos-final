// prisma/schema/workout.prisma

model Exercise {
  id              String   @id @default(uuid())
  name            String   
  category        String
  subCategory     String?  @default("Geral") 

  howToExecute    String?  @db.Text
  commonMistakes  String?  @db.Text
  maleFocus       String?  @db.Text
  femaleFocus     String?  @db.Text
  
  environments    String[] @default(["ACADEMIA"])

  tags            Json?
  defaultSubstitutes String[] @default([])
  
  videoUrl        String?
  instructions    String?
  createdAt       DateTime @default(now())
  
  coachId         String?
  coach           User?    @relation("CoachExercises", fields: [coachId], references: [id], onDelete: Cascade)

  workoutExercises WorkoutExercise[] 
  asSubstitute     WorkoutExercise[] @relation("SubstituteRelation")

  @@unique([name, coachId])
}

model Workout {
  id        String   @id @default(uuid())
  name      String   
  goal      String?   
  level     String?   
  isVisible Boolean   @default(true)
  
  startDate DateTime? @default(now())
  endDate   DateTime?
  archived  Boolean   @default(false)

  // 🔥 ALTERNÂNCIA SEMANAL: null = sempre visível pro aluno (padrão, não muda
  // nada pra quem não usa). 1, 2... = só aparece nas semanas cujo índice bate
  // com esse slot, contando em blocos de 7 dias a partir do startDate mais
  // antigo entre os treinos ativos do aluno que tiverem esse campo setado.
  // Calculado em tempo real no app do aluno (TrainingScreen.js) — não é um
  // campo que muda sozinho no banco.
  alternateSlot Int?

  workoutModel String @default("CARGA")

  intensityMultiplier Float     @default(1.0)
  intensityEndDate    DateTime? 
  
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises WorkoutExercise[]
  shares    WorkoutShare[]
  createdAt DateTime  @default(now())
}

// 🔗 (2 out 2026) LINK DO TREINO EM PÁGINA: o coach cria um endereço (elitefitapp.com.br/t/?c=<code>) que mostra o treino do aluno numa página
// pública, sem app e sem login. Cada link tem as escolhas do coach: mostrar (ou não) o nome do aluno, quais dias aparecem (vazio = todos) e a
// validade (null = não expira). Pode ser desativado a qualquer momento (revokedAt). O conteúdo é SEMPRE o treino atual (não é uma cópia).
// Tabela nova: só adiciona (rodar `npx prisma db push` ANTES de publicar o backend).
model WorkoutShare {
  id           String    @id @default(uuid())
  code         String    @unique
  // O link aponta para UM destes dois: o treino salvo de um aluno (workoutId) ou um treino AVULSO do coach (quickWorkoutId).
  workoutId    String?
  workout      Workout?  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  quickWorkoutId String?
  quickWorkout   QuickWorkout? @relation(fields: [quickWorkoutId], references: [id], onDelete: Cascade)
  createdById  String?
  showName     Boolean   @default(false)
  displayName  String?   // nome livre que o coach digitou para aparecer na página ("Treino de ..."); vazio = 1º nome do aluno (treino de aluno)
  days         String[]  @default([])
  expiresAt    DateTime?
  revokedAt    DateTime?
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())
  // Avisos ao coach (push): `notifyOpen` = na 1ª vez que abrirem o link; `notifyDone` = quando alguém concluir um dia do treino.
  notifyOpen   Boolean   @default(false)
  notifyDone   Boolean   @default(false)
  // 🎁 (5 out 2026) TESTE GRÁTIS: link de demonstração para quem ainda não é aluno (só a equipe master cria). A página mostra a faixa "Teste grátis", o
  // carrossel "como é o acompanhamento" e o botão de WhatsApp; quando o link vence, mostra o convite para falar no WhatsApp. Coluna nova (só adiciona):
  // rodar `npx prisma db push` ANTES de publicar o backend.
  trial        Boolean   @default(false)
  // 📈 (5 out 2026) PROGRESSO DO TESTE GRÁTIS: o que a pessoa fez na página (cargas por série, "Ant", exercícios marcados, trocas), enviado pela própria página só nos links
  // de teste grátis. JSON { [vid]: { at, loads, prev, done, swaps } } (até 3 aparelhos). O coach lê o relatório em GET /api/workout-share/progress. Colunas novas (só adicionam):
  // rodar `npx prisma db push` ANTES de publicar o backend.
  progress     String?   @db.Text
  progressAt   DateTime?
  doneCount    Int       @default(0)       // conclusões já recebidas (cada pessoa conta uma vez por dia de treino)
  lastDoneAt   DateTime?
  dones        WorkoutShareDone[]

  @@index([workoutId])
  @@index([quickWorkoutId])
}

// 🔗 Conclusão de um dia de treino numa página pública. `vid` é um id aleatório do NAVEGADOR de quem treinou (não identifica a pessoa): serve só para
// contar cada pessoa uma vez por dia de treino. Vem de uma rota pública, por isso há limites (lib/workoutShare.ts) e o apagar do link leva tudo junto.
model WorkoutShareDone {
  id        String       @id @default(uuid())
  shareId   String
  share     WorkoutShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  vid       String
  day       String
  createdAt DateTime     @default(now())

  @@unique([shareId, vid, day])
  @@index([shareId])
}

// 🔗 (2 out 2026) TREINO AVULSO: treino do coach que NÃO é de nenhum aluno (montado do zero ou importado de uma base / de um aluno) só para
// virar um link de página (ver WorkoutShare). Mesmo formato dos templates: `data` = JSON {"A":[exercícios do editor], "B":[...]}.
// Fica separado de propósito: não aparece em Meus Templates, nem nas telas, contagens e feed dos alunos.
// Tabela nova: só adiciona (rodar `npx prisma db push` ANTES de publicar o backend).
model QuickWorkout {
  id        String   @id @default(uuid())
  coachId   String
  coach     User     @relation("CoachQuickWorkouts", fields: [coachId], references: [id], onDelete: Cascade)
  name      String
  data      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shares    WorkoutShare[]

  @@index([coachId])
}

model WorkoutExercise {
  id                String     @id @default(uuid())
  workoutId         String
  workout           Workout    @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  
  exerciseId        String
  exercise          Exercise   @relation(fields: [exerciseId], references: [id])
  
  substituteId      String?
  substitute        Exercise?  @relation("SubstituteRelation", fields: [substituteId], references: [id])

  substitutes       String[]   @default([])

  restTime          Int        @default(60)
  title             String?  
  sets              Int        @default(3)
  reps              String     @default("12") 
  notes             String?  
  
  technique         String?    
  
  customTechniqueId String?
  customTechnique   Technique? @relation(fields: [customTechniqueId], references: [id], onDelete: SetNull)

  day               String     @default("A") 
  order             Int        @default(0) 

  observation       String?  
}

model TemplateCollection {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#22c55e") 
  createdAt DateTime @default(now())

  coachId   String?
  coach     User?    @relation("CoachCollections", fields: [coachId], references: [id], onDelete: Cascade)

  templates WorkoutTemplate[]
}

model WorkoutTemplate {
  id        String   @id @default(uuid())
  name      String   
  goal      String   
  level     String   
  data      String   @db.Text 
  createdAt DateTime @default(now())

  coachId   String?
  coach     User?    @relation("CoachTemplates", fields: [coachId], references: [id], onDelete: Cascade)

  collectionId String?
  collection   TemplateCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
}

// 🔥 NOVO: estruturas de pirâmide criadas pelo coach (ex: "20-15-12-10"),
// pra reusar com um toque, além das 8 fixas que já vêm no app.
model PyramidPreset {
  id        String   @id @default(uuid())
  structure String
  createdAt DateTime @default(now())
}

// 🔥 NOVO: observações rápidas criadas pelo coach pra inserir com um toque
// na observação do exercício, além das fixas que já vêm no app (QUICK_OBS).
model ObservationPreset {
  id        String   @id @default(uuid())
  text      String   @db.Text
  createdAt DateTime @default(now())
}

model MotorTemplate {
  id          String   @id @default(uuid())
  name        String   
  
  objectives  String[] 
  levels      String[] 
  times       Int[]    
  days        Int[]    
  
  structure   String   @db.Text 
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  coachId     String?
  coach       User?    @relation("CoachMotorTemplates", fields: [coachId], references: [id], onDelete: Cascade)
}

model WorkoutHistory {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name             String   
  workoutName      String? 
  date             DateTime @default(now())
  xpEarned         Int      @default(0)
  duration         Int?     
  progressions     Int      @default(0) 

  rpe              Int?
  feedback         String?

  // 🔥 (1 out 2026) Qual treino/dia foi feito (letra do dia: "A", "B"...) e de qual
  // ficha (Workout.id, sem @relation de propósito: a ficha pode ser apagada depois).
  // O feedback da semana usa isso pra dizer "faltou o Treino C" em vez de só contar.
  // Registros antigos ficam null (o servidor deduz o dia pelos exercícios feitos).
  day              String?
  workoutId        String?

  // 🔥 (17 set 2026) Resolver/responder o feedback final do treino — o coach
  // marca que já viu/tratou e opcionalmente deixa uma resposta, que dispara
  // um push de volta pro aluno (ver /api/admin/workout-history/[id]/resolve).
  feedbackResolvedAt DateTime?
  coachReply         String?    @db.Text
  coachReplyAt       DateTime?

  // 🔒 (1 out 2026) Chave de IDEMPOTÊNCIA da finalização do treino: o app manda uma chave fixa por sessão de treino (workoutId + dia + hora em
  // que o cronômetro começou), então "SALVAR E FINALIZAR" tocado várias vezes (internet lenta) ou reenviado depois de uma falha grava UM treino só
  // (um XP, um aviso para o coach, uma contagem). O índice único garante isso mesmo com dois pedidos chegando no mesmo instante.
  // Registros antigos ficam null (o Postgres não considera null igual a null no índice único).
  clientKey        String?

  // ⏱️ (6 out 2026) Pergunta OPCIONAL ao finalizar o treino: "deu tempo de fazer tudo?". null = o aluno não respondeu (entende-se que deu tempo);
  // true = respondeu SIM; false = respondeu NÃO e `timeNote` diz o que faltou (ex.: "esteira", "os últimos exercícios"). Nunca bloqueia o finalizar.
  // Quem decide o que fazer (menos séries, descanso menor, bi-set...) é o coach: o app só avisa, não muda a ficha sozinho.
  timeOk           Boolean?
  timeNote         String?  @db.Text

  details          ExerciseHistory[]

  @@unique([userId, clientKey])
}

// 🔔 (7 out 2026) SESSÃO DE TREINO: nasce quando o aluno toca em INICIAR TREINO (o app avisa o servidor) e fecha quando ele finaliza o treino.
// Antes o servidor só sabia do treino DEPOIS de finalizado: quem esquecia de finalizar sumia (o tempo e as cargas ficavam só no celular).
// Agora, se a sessão fica aberta por horas, o servidor manda um push ("Você terminou o treino?", no máximo 2 avisos, nunca de madrugada).
// `clientKey` é a MESMA chave que o app manda ao finalizar (WorkoutHistory.clientKey): é assim que a sessão é fechada.
model WorkoutSession {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientKey     String
  workoutId     String?
  day           String?
  workoutName   String?

  startedAt     DateTime  @default(now())
  finishedAt    DateTime?

  remindedAt    DateTime?
  reminderCount Int       @default(0)

  @@unique([userId, clientKey])
  @@index([finishedAt, startedAt])
}

model ExerciseHistory {
  id               String         @id @default(uuid())
  workoutHistoryId String
  workoutHistory   WorkoutHistory @relation(fields: [workoutHistoryId], references: [id], onDelete: Cascade)

  exerciseId       String
  exerciseName     String

  setNumber        Int
  // ⚖️ (3 out 2026) `weight` é SEMPRE a carga TOTAL em kg (soma dos dois lados), como sempre foi: evolução, "Puxar cargas", estagnação, volume e
  // a IA continuam lendo esse número sem mudar nada. `perSide` só diz COMO o aluno anotou: true = ele digitou o peso de UM lado (ou de um halter)
  // e o app já gravou o dobro em `weight`. Para mostrar "20 kg cada lado": weight / 2. Registros antigos = false (total).
  weight           Float
  perSide          Boolean        @default(false)
  reps             String

  note             String?  @db.Text

  // 🚴 (7 out 2026) CARDIO feito de verdade: o tempo (segundos) e as calorias que o aluno registrou depois do cardio guiado (ou digitou). Nulo = treino antigo
  // ou exercício que não é cardio. `weight` continua guardando os minutos, como sempre foi (compatibilidade); estes dois são o dado exato.
  cardioSeconds    Int?
  cardioKcal       Int?

  // 🔥 (17 set 2026) Mesma ideia do WorkoutHistory acima, só que pra uma
  // observação específica de exercício (o aluno reclamou de dor/dificuldade
  // num exercício certo, não do treino inteiro).
  resolvedAt       DateTime?
  coachReply       String?    @db.Text
  coachReplyAt     DateTime?
}

model Technique {
  id          String   @id @default(uuid())
  name        String   
  description String?  @db.Text
  
  steps       Json
  videoUrl    String?     

  isGlobal    Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  coachId     String?
  coach       User?    @relation("CoachTechniques", fields: [coachId], references: [id], onDelete: Cascade)

  workoutExercises WorkoutExercise[]
}

model SystemTechniqueVideo {
  id        String   @id @default(uuid())
  key       String   // 🔥 O @unique saiu daqui!
  videoUrl  String
  teamId    String   @default("MASTER_TEAM") // 🔥 Nova coluna
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, teamId]) // 🔥 Agora a exclusividade é a combinação da técnica com o time
}

// 🤖 (3 out 2026) PLANO AUTOMÁTICO: quando o aluno de um plano com montagem automática (FICHA_8S, CHALLENGE_21) termina a anamnese, o servidor monta
// o treino e a dieta dele sozinho (lib/autoPlan.ts). Uma linha por aluno guarda o ESTADO dessa montagem: o app do aluno acompanha o progresso,
// o servidor retoma de onde parou se cair no meio (deploy, falha da IA) e o coach vê o que foi gerado e quanto custou.
model AutoPlanRun {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan       String                       // FICHA_8S | CHALLENGE_21 (o plano do aluno quando começou)
  status     String   @default("PENDING") // PENDING | RUNNING | DONE | FAILED | MANUAL (coach precisa montar à mão)
  step       String?                      // o que está sendo feito agora (WORKOUT | DIET | SAVING | DONE)
  attempts   Int      @default(0)
  error      String?  @db.Text

  workoutIds String[] @default([])        // treinos criados (um por fase)
  dietId     String?
  summary    Json?                        // fases, macros, custo estimado, pontos de atenção para o coach revisar

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([status])
}
