// prisma/schema/content.prisma

model Notice {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  active    Boolean  @default(true)
  date      DateTime @default(now())

  coachId   String?
  coach     User?    @relation("CoachNotices", fields: [coachId], references: [id], onDelete: Cascade)
}

model Content {
  id          String   @id @default(uuid())
  title       String
  subtitle    String?
  description String?  @db.Text
  
  category    String   
  
  type        String   @default("video")
  isVIP       Boolean  @default(false)

  // 🔥 Preço de venda avulsa (PIX/cartão) via Biblioteca — só relevante quando
  // isVIP=true e o aluno não tem ContentAccess. Null/0 = não é vendável (só
  // libera manualmente pelo admin, ex: aula VIP de brinde).
  valor       Float?

  videoUrl    String?
  pdfUrl      String?
  audioUrl    String?
  thumbUrl    String?
  duration    String?

  createdAt   DateTime @default(now())

  coachId     String?
  coach       User?    @relation("CoachContents", fields: [coachId], references: [id], onDelete: Cascade)

  likes       ContentLike[]
  comments    ContentComment[]
  completions ContentCompletion[]
  unlockedFor ContentAccess[]
  purchases   Payment[]
}

model ContentLike {
  id        String   @id @default(uuid())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  contentId String
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())

  @@unique([userId, contentId])
}

model ContentComment {
  id        String   @id @default(uuid())
  text      String   @db.Text
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  contentId String
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())

  parentId  String?
  parent    ContentComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ContentComment[] @relation("CommentReplies")
}

model ContentCompletion {
  id        String   @id @default(uuid())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  contentId String
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())

  @@unique([userId, contentId]) 
}

model ContentAccess {
  id        String   @id @default(uuid())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  contentId String
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, contentId]) 
}

// =============================================================================
// 🔥 ADICIONADO: MÓDULO DE PRODUTOS DIGITAIS, E-BOOKS E ORDER BUMP
// =============================================================================

model ProdutoDigital {
  id              String   @id @default(uuid())
  slug            String   @unique
  nome            String
  descricao       String?  @db.Text
  capaUrl         String?
  valor           Float
  precoDe         Float?   // Preço "de" riscado, exibido acima do valor final (âncora de valor)
  ativo           Boolean  @default(true)
  coachId         String   // Paulo ou Adri
  linkEntrega     String?  // Link do Google Drive, PDF do e-book, etc.

  // 🔥 PÁGINA DE VENDAS: benefícios em bullets ("O que você vai receber") —
  // um item por linha, texto livre; e prévia visual do conteúdo — array JSON
  // de URLs de imagem (prints/páginas do material), além da capa principal.
  beneficios      String?  @db.Text
  imagensExtra    String?  @db.Text // JSON.stringify(string[])

  // 🔥 ORDER BUMP MULTI-ITEM: em vez de um único bump de texto livre, o admin
  // escolhe outros ProdutoDigital já cadastrados (outros ebooks/audiobooks)
  // pra oferecer como upsell no checkout — array JSON de ids. O cliente pode
  // marcar quantos quiser; cada um vira sua própria linha em ProdutoVenda e
  // libera seu próprio linkEntrega quando o pagamento é confirmado.
  orderBumpProdutoIds String? @db.Text // JSON.stringify(string[]) — ids de outros ProdutoDigital

  // 🔥 PROVA SOCIAL E OBJEÇÕES: cada campo é opcional e independente — se o
  // admin deixar vazio, a seção correspondente simplesmente não aparece na
  // página (autonomia total sobre o que mostrar por produto).
  depoimentos     String?  @db.Text // JSON.stringify({nome, texto, fotoUrl?, estrelas?}[])
  antesDepois     String?  @db.Text // JSON.stringify({antesUrl, depoisUrl, legenda?}[])
  faq             String?  @db.Text // JSON.stringify({pergunta, resposta}[])

  // 🔥 TREINO INTERATIVO: opcional — se preenchido, quem compra ganha acesso a
  // uma página web (sem login, via link mágico) com os treinos estruturados,
  // check-in de sessão e registro de carga, em vez de só um PDF/link estático.
  // JSON.stringify({ duracaoSemanas, treinos: [{ nome, foco, descanso,
  //   exercicios: [{ ordem, nome, seriesRepeticoes, muscPrincipal, muscSecundario, orientacao, videoUrl }] }] })
  treinoPrograma  String?  @db.Text
  treinoAcessos   ProdutoTreinoAcesso[]

  vendas          ProdutoVenda[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ProdutoVenda {
  id              String   @id @default(uuid())
  produtoId       String
  produto         ProdutoDigital @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  nomeCliente     String
  emailCliente    String
  telefoneCliente String
  cpfCliente      String

  status          String   @default("PENDENTE") // PENDENTE, PAGO
  valorTotal      Float    // Armazena o valor consolidado final cobrado no Asaas (produto principal + bumps)
  itensBumpIds    String?  @db.Text // JSON.stringify(string[]) — ids dos ProdutoDigital extras comprados junto

  asaasPaymentId  String?  @unique
  asaasCustomerId String?
  pixQrCode       String?  @db.Text
  pixCopyPaste    String?  @db.Text
  invoiceUrl      String?  @db.Text

  // 🔥 RECUPERAÇÃO DE CARRINHO ABANDONADO: marca se já mandamos o e-mail de
  // lembrete pra essa venda PENDENTE — evita reenviar toda vez que a rotina
  // de checagem rodar de novo.
  lembreteAbandonoEnviado Boolean @default(false)

  // 🔥 TREINO INTERATIVO: um acesso por item comprado (principal ou bump) que
  // tiver treinoPrograma configurado.
  treinoAcessos   ProdutoTreinoAcesso[]

  paymentDate     DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// 🔥 TREINO INTERATIVO — acesso por link mágico (sem senha, sem conta) a um
// programa de treino estruturado, gerado automaticamente quando a venda de um
// ProdutoDigital com treinoPrograma configurado é confirmada. O token é a
// única credencial (mesmo padrão do FormResponse.publicToken já usado em
// outro módulo) — suficiente pra esse caso de uso de baixo risco.
model ProdutoTreinoAcesso {
  id            String   @id @default(uuid())
  token         String   @unique

  vendaId       String
  venda         ProdutoVenda   @relation(fields: [vendaId], references: [id], onDelete: Cascade)

  produtoId     String
  produto       ProdutoDigital @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  nomeCliente   String

  // JSON.stringify({ sessoes: [{ treinoIndex, data, cargas: { [exercicioIndex]: peso } }] })
  // Sempre um APPEND — nunca sobrescreve — porque a mesma ficha é repetida
  // semanalmente ao longo das 8 semanas do protocolo.
  progresso     String?  @db.Text

  ultimoAcesso  DateTime?
  createdAt     DateTime @default(now())

  @@unique([vendaId, produtoId])
}