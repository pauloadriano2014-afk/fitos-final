// prisma/schema/finance.prisma

model PaymentGatewayAccount {
  id            String   @id @default(uuid())
  coachId       String   @unique
  provider      String   @default("ASAAS")
  asaasApiKey   String
  asaasWalletId String?
  isActive      Boolean  @default(true)

  // 🧾 Configuração padrão de nota fiscal (NFS-e via Asaas), usada toda vez
  // que o coach clica em "Emitir Nota" num pagamento/recebimento — evita
  // preencher serviço/alíquota de novo a cada emissão (ver
  // app/api/finance/fiscal-config e app/api/finance/invoice). O status de
  // "conta fiscal configurada ou não" em si NÃO fica salvo aqui — é sempre
  // consultado ao vivo na Asaas (GET /v3/fiscalInfo/), pra nunca mostrar uma
  // informação desatualizada.
  defaultMunicipalServiceId   String?
  defaultMunicipalServiceCode String?
  defaultMunicipalServiceName String?
  defaultServiceDescription   String? @db.Text
  defaultIssRate               Float?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]
  payments      Payment[]
}

// status: PENDING_CHECKOUT (aguardando o aluno terminar o Asaas Checkout) |
// ACTIVE (recorrência confirmada, cobrando sozinha a cada ciclo) |
// CANCELLED | EXPIRED (checkout expirou sem o aluno completar)
model Subscription {
  id                  String    @id @default(uuid())
  userId              String
  coachId             String
  gatewayAccountId    String
  asaasCustomerId     String
  asaasSubscriptionId String?
  asaasCheckoutId     String?   @unique // id do Asaas Checkout que originou essa assinatura (recorrência via cartão)
  planName            String
  value               Float
  cycle               String    @default("MONTHLY")
  billingType         String    @default("UNDEFINED")
  status              String    @default("ACTIVE")
  nextDueDate         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  gatewayAccount PaymentGatewayAccount @relation(fields: [gatewayAccountId], references: [id])
  payments       Payment[]

  @@index([userId])
  @@index([coachId])
}

// 💵 RECEBIMENTO MANUAL (fora da Asaas) -- PIX direto na conta do coach,
// dinheiro, transferência etc. Não é um pagamento processado pela
// plataforma (por isso não tem gatewayAccountId/asaasPaymentId, ao
// contrário do Payment); é só o registro que o próprio coach faz na hora
// de marcar um aluno como "pago" pra esse valor entrar no relatório de
// Imposto de Renda dele (ver app/api/finance/report). Criado a partir de
// AGORA em diante -- não existe backfill automático de recebimentos
// antigos que nunca foram registrados.
model ManualReceipt {
  id          String   @id @default(uuid())

  coachId     String
  coach       User     @relation("CoachManualReceipts", fields: [coachId], references: [id], onDelete: Cascade)

  // Snapshot do nome do aluno no momento do registro -- funciona tanto pra
  // aluno com conta no app (studentId preenchido) quanto pra aluno offline
  // (studentId null, já que OfflineClient não é um User e não vale a pena
  // criar uma segunda FK opcional só pra isso).
  studentId   String?
  studentName String

  value       Float
  method      String   @default("PIX") // PIX | CARTAO | DINHEIRO | TRANSFERENCIA | OUTRO
  receivedAt  DateTime
  note        String?

  createdAt   DateTime @default(now())

  invoices    Invoice[]

  @@index([coachId])
  @@index([receivedAt])
}

model Payment {
  id               String    @id @default(uuid())
  subscriptionId   String?
  userId           String
  coachId          String
  gatewayAccountId String
  asaasPaymentId   String    @unique
  value            Float
  netValue         Float?
  billingType      String
  status           String    @default("PENDING")
  dueDate          DateTime
  paymentDate      DateTime?
  invoiceUrl       String?
  pixQrCode        String?   @db.Text
  pixCopyPaste     String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // 🔥 Preenchido só nas compras avulsas de conteúdo (ebook/audiobook) via
  // Biblioteca — ver app/api/payments/content/create. Null pros pagamentos
  // de mensalidade/recorrência (fluxo original, sem mudanças).
  contentId        String?
  content          Content?              @relation(fields: [contentId], references: [id], onDelete: SetNull)

  subscription   Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  gatewayAccount PaymentGatewayAccount @relation(fields: [gatewayAccountId], references: [id])
  invoices       Invoice[]

  @@index([userId])
  @@index([coachId])
  @@index([asaasPaymentId])
  @@index([contentId])
}

// 🧾 NOTA FISCAL (NFS-e) emitida via Asaas para um Payment (processado pela
// Asaas) OU um ManualReceipt (recebimento fora da Asaas, lançado à mão) —
// sempre por botão manual, nunca automático (decisão do Paulo). A nota vale
// pro CNPJ configurado na PaymentGatewayAccount do coachId abaixo — fase 1:
// só o coachId 'paulo' (PA ELITE TEAM LTDA) tem conta fiscal configurada,
// então essa emissão ainda não está disponível pra coachs parceiros (ver
// discussão sobre DEFAULT_COACH_ID hardcoded nas rotas de cobrança).
model Invoice {
  id              String   @id @default(uuid())
  coachId         String

  asaasInvoiceId  String   @unique

  paymentId       String?
  payment         Payment?       @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  manualReceiptId String?
  manualReceipt   ManualReceipt? @relation(fields: [manualReceiptId], references: [id], onDelete: SetNull)

  studentName     String
  value           Float

  // Espelha o status da Asaas, atualizado pelo webhook INVOICE_* (ver
  // app/api/payments/webhook): SCHEDULED | SYNCHRONIZED | AUTHORIZED |
  // ERROR | CANCELED | PROCESSING_CANCELLATION | CANCELLATION_DENIED
  status          String   @default("SCHEDULED")
  pdfUrl          String?
  xmlUrl          String?
  errorMessage    String?  @db.Text

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([coachId])
  @@index([paymentId])
  @@index([manualReceiptId])
}

model SalesPageConfig {
  id              String   @id @default(uuid())
  
  coachId         String   @unique
  coach           User     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  
  pageTitle       String?  @default("Minha Consultoria")
  aboutText       String?  @db.Text
  videoUrl        String?  
  coachPhotoUrl   String?  
  galleryPhotos   String[] @default([]) 

  galleryTexts      String[] @default([]) 
  testimonialNames  String[] @default([]) 
  testimonialTexts  String[] @default([]) 

  pixKey            String?
  pixName           String?

  themeColor      String?  @default("#4DE38F") 
  appFeatures     String[] @default([]) 
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CoachPlan {
  id               String   @id @default(uuid())
  
  coachId          String
  coach            User     @relation("CoachPlans", fields: [coachId], references: [id], onDelete: Cascade)
  
  name             String   
  description      String?  @db.Text
  value            Float    
  promotionalValue Float?   
  durationInMonths Int      @default(1) 
  discountPerc     Int      @default(0)

  paymentUrl       String?
  isActive         Boolean  @default(true)
  isPromoActive    Boolean  @default(false)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// PropostaOferta — conjuntos de preços/planos customizados para a página
// de vendas PropostaScreen (high-ticket, padrão, testes de preço, etc.).
// Acessada publicamente via ?oferta=slug na URL da proposta; gerenciada
// pelos coaches master (Paulo/Adri) na tela AdminPropostaOfertasScreen.
// ─────────────────────────────────────────────────────────────────────────
model PropostaOferta {
  id          String   @id @default(uuid())

  slug        String   @unique
  nome        String   
  ativa       Boolean  @default(true)

  // Array de "cards" de plano (nome, descrição, itens, preços por período,
  // CTA etc.), guardado como JSON — ver estrutura documentada no código
  // do AdminPropostaOfertasScreen.js / PropostaScreen.js
  cards       Json

  criadoPorId String?  

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// DesafioConfig — configuração reutilizável de um desafio/projeto por
// WhatsApp (ex: "Desafio 90 Dias"). Pode criar quantos quiser no futuro
// (30 dias, 60 dias, turmas diferentes), cada um com seu próprio slug,
// valor e link de grupo — sem precisar de código novo por lançamento.
// Gerenciado pelos coaches master na aba DESAFIOS do admin.
// ─────────────────────────────────────────────────────────────────────────
model DesafioConfig {
  id             String   @id @default(uuid())

  slug           String   @unique   // identificador na URL pública (?desafio=slug)
  nome           String             // ex: "Desafio 90 Dias"
  descricao      String?  @db.Text  // texto de apresentação exibido na página pública
  logoUrl        String?            // banner/logo horizontal exibido no topo da página, substitui o ícone padrão
  beneficios     String[] @default([]) // lista de "o que você vai receber" — editável por desafio
  valor          Float              // valor cobrado, pagamento único via PIX
  duracaoDias    Int      @default(90) // usado pra calcular "R$ X por dia" na página
  // Data oficial de início do desafio (Dia 1). Opcional — se não preenchida,
  // a página de check-in não mostra "Dia X" nem bloqueia por data, funciona
  // como sempre funcionou. Preenchida, junto com duracaoDias define a janela
  // válida de check-in (dataInicio até dataInicio + duracaoDias).
  dataInicio     DateTime?
  linkGrupoWhats String             // link de convite do grupo — SÓ é revelado após pagamento confirmado
  coachId        String             // dono do desafio (Paulo ou Adri) — usado pra achar a PaymentGatewayAccount certa
  ativo          Boolean  @default(true)

  // Pontuação do check-in — quantos pontos vale CADA item marcado/enviado.
  // Multiplicador aplicado sobre a pontuação fixa de cada item (ver
  // DesafioCheckin.pontos) — 1 = sem alteração, 2 = dobra tudo naquele dia.
  // Aceita decimal (ex: 1.5) pra mais controle fino.
  // Padrão é 1 em todos os dias (sem bônus automático) — se quiser que o
  // fim de semana valha mais, é uma escolha explícita feita no admin, não
  // um comportamento fixo do sistema.
  pontosPorItem             Float @default(1) // segunda a sexta
  pontosPorItemFimDeSemana  Float @default(1) // sábado e domingo

  // Exceções pontuais de pontuação (feriados, datas comemorativas etc.) —
  // sobrescreve o peso normal só naquele dia específico. Anunciado com
  // antecedência na página pública assim que cadastrado.
  datasEspeciais DesafioDataEspecial[]

  // Perfil de quem conduz o desafio (ex: Adri) — opcional; se mentorNome
  // não for preenchido, essa seção simplesmente não aparece na página.
  mentorNome     String?
  mentorFotoUrl  String?
  mentorTexto    String?  @db.Text

  // Seções adicionais de copy — todas opcionais, cada uma some da página
  // se não for preenchida.
  paraQuemE      String[] @default([]) // "Esse projeto é para você que..."
  importante     String?  @db.Text     // aviso — ex: não substitui a consultoria individual
  compromissoTexto String? @db.Text    // "Meu compromisso" — parágrafo pessoal
  bonusTexto     String?  @db.Text     // "Bônus Exclusivo" — teaser pra próxima oferta, no fim da página

  // Galeria de antes/depois — mesmo padrão de pares usado em SalesPageConfig
  // (índices consecutivos: [0]=antes1, [1]=depois1, [2]=antes2, [3]=depois2...)
  galleryPhotos  String[] @default([])
  galleryTexts   String[] @default([])

  inscricoes     DesafioInscricao[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// DesafioInscricao — cada cadastro individual feito na página pública do
// Desafio. Fica numa lista própria, separada dos Alunos/CRM principal.
model DesafioInscricao {
  id               String    @id @default(uuid())

  desafioId        String
  desafio          DesafioConfig @relation(fields: [desafioId], references: [id], onDelete: Cascade)

  nome             String
  dataNascimento   DateTime
  email            String
  telefone         String
  cpf              String    // exigido pela Asaas pra gerar cobrança/PIX

  status           String    @default("PENDENTE") // PENDENTE | PAGO | CANCELADO | EXPIRADO
  asaasCustomerId  String?
  asaasPaymentId   String?   @unique
  pixQrCode        String?   @db.Text // imagem base64 do QR Code retornada pela Asaas
  pixCopyPaste     String?   @db.Text // código "copia e cola" do PIX
  invoiceUrl       String?
  paymentDate      DateTime?

  isLeadFuturo     Boolean   @default(true)

  // Inscrição criada pelo admin só pra testar o fluxo (check-in, fotos etc.)
  // sem precisar pagar de verdade. Aparece na tela de check-ins do admin
  // (pra você confirmar que funcionou), mas é EXCLUÍDA do ranking.
  isTeste          Boolean   @default(false)

  checkins         DesafioCheckin[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([desafioId])
  @@index([status])
  @@index([asaasPaymentId])
}

// DesafioCheckin — check-in diário de uma participante (treino, cardio,
// alimentação, água, foto na academia). Aos sábados, ganha 3 campos extras
// de foto do shape (frente/lado/costas). Um check-in por pessoa por dia
// (garantido pelo @@unique abaixo) — reabrir o link no mesmo dia atualiza
// o registro em vez de duplicar.
model DesafioCheckin {
  id               String   @id @default(uuid())

  inscricaoId      String
  inscricao        DesafioInscricao @relation(fields: [inscricaoId], references: [id], onDelete: Cascade)

  data             DateTime // só a data (sem hora) do dia do check-in

  treino           Boolean  @default(false)
  cardio           Boolean  @default(false)
  alimentacao      Boolean  @default(false)
  agua             Boolean  @default(false)
  missaoPercentual Int      @default(0) // 0-100 — quanto da "missão semanal" (Adri) foi cumprido; pontos são proporcionais
  fotoAcademiaUrl  String?  // = "check-in" na tabela de pontos (comprova presença)

  // Só preenchido aos sábados
  fotoFrenteUrl    String?
  fotoLadoUrl      String?
  fotoCostasUrl    String?
  pesoKg           Float?   // peso digitado junto com as fotos de sábado

  // Pontuação fixa por item (treino=10, cardio=10, água=5, alimentação=10,
  // missão=15, check-in/foto=5), multiplicada pelo peso do dia (normal,
  // fim de semana ou data especial) — calculado e salvo no momento do
  // check-in, pra tornar o ranking uma soma simples.
  pontos           Int      @default(0)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([inscricaoId, data])
  @@index([inscricaoId])
}

// DesafioDataEspecial — exceção pontual de pontuação (feriado, data
// comemorativa etc.). Sobrescreve pontosPorItem/pontosPorItemFimDeSemana
// só naquele dia específico. A página pública de check-in mostra essas
// datas com antecedência (aviso prévio) e um banner especial no dia.
model DesafioDataEspecial {
  id            String   @id @default(uuid())

  desafioId     String
  desafio       DesafioConfig @relation(fields: [desafioId], references: [id], onDelete: Cascade)

  data          DateTime // só a data (sem hora), mesmo padrão do DesafioCheckin
  pontosPorItem Float    // multiplicador nesse dia específico — substitui o normal (1 = sem alteração)
  motivo        String   // ex: "Feriado de 7 de setembro" — aparece no aviso da página

  createdAt     DateTime @default(now())

  @@unique([desafioId, data])
  @@index([desafioId])
}
