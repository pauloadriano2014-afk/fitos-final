// prisma/schema/user.prisma

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  password          String
  name              String?
  birthDate         String?
  phone             String?
  cpf               String?
  // 🔥 Endereço de cobrança — exigido pelo Asaas Checkout pra ativar
  // recorrência com cartão (ver app/api/payments/recurrence/create/route.ts)
  address           String?
  addressNumber     String?
  complement        String?
  province          String?   // bairro
  postalCode        String?   // CEP (só dígitos)
  gender            String?
  aiLogs            AiLog[]
  dailyCheckins     DailyCheckin[]
  dietFeedbacks     DietFeedback[]
  dietMealLogs      DietMealLog[]
  npsRequested      Boolean  @default(false)
  accountStatus     String  @default("ACTIVE")
  // 🔥 (17 set 2026) Pedido de auto-exclusão de conta de um COACH que ainda
  // tem aluno ativo -- fica pendente aqui em vez de anonimizar na hora, pra
  // não deixar os alunos dele com o coachId apontando pra uma conta já
  // anonimizada. Ver lib/accountDeletion.ts e app/api/admin/deletion-requests.
  // Sempre null pra aluno (aluno exclui na hora, sem essa etapa).
  deletionRequestedAt DateTime?
  inviteCode        String? @unique
  coachRequestInfo  Json?
  studentModules      String?   @default("TREINO")
  coachPlan           String?   @default("PERSONAL")
  coachBillingPlan    String?
  coachBillingStart   DateTime?
  coachBillingEnd     DateTime?
  coachAsaasId        String?
  coachAsaasChargeId  String?
  coachBillingStatus  String?   @default("PENDING")
  // 🔥 Fim do teste grátis de 7 dias (setado na aprovação do coach em
  // coach-requests) — usado pra bloquear o acesso quando coachBillingStatus
  // ainda está em "TRIAL" e essa data já passou sem nenhum plano pago criado.
  trialEndsAt         DateTime?
  isLaunchPromo       Boolean   @default(false)
  onboardingCompleted Boolean   @default(false)
  onboardingStep      Int       @default(0)
  aiCheckinPrompt     String?   @db.Text
  aiPromptMode        String?   @default("ADD")
  
  plan_tier         String   @default("standard")
  role              String   @default("USER") 
  plan              String   @default("PERFORMANCE") 
  active            Boolean  @default(true)
  
  asaasCustomerId     String?
  asaasSubscriptionId String?
  coachAsaasApiKey    String?

  subscriptions   Subscription[]
  payments        Payment[]

  brandLogoUrl        String?
  brandColor          String?

  isTestAccount       Boolean  @default(false) 
  
  contractType      String?   @default("Mensal") 
  contractValue     Float?    @default(0.0)
  paymentDueDate    DateTime? 
  startDate         DateTime? 
  nextWorkoutUpdate DateTime? 
  financeCategory   String?   @default("Consultoria Online") 
  isFinanceActive   Boolean   @default(true)

  paymentClaimedAt         DateTime? 
  paymentClaimStatus       String?   
  paymentClaimCycleDueDate DateTime? 

  currentWeight   Float? 
  
  currentXP       Int      @default(0)
  pushToken       String?
  // 🔥 Web Push (17 set 2026) — DEPRECATED (19 set 2026): guardava só UMA
  // assinatura por usuário, então um segundo navegador (ex: PC depois do
  // celular) sobrescrevia a anterior e um dos dois parava de receber
  // notificação. Substituído pela relação webPushSubscriptions (ver embaixo
  // do model), que permite várias por usuário. Mantido aqui só pra não
  // quebrar quem ainda tiver alguma leitura antiga por aí — nada em código
  // novo escreve ou lê esse campo.
  webPushSubscription Json?

  photoUrl        String?
  evaluationUrl   String?  
  nextCheckInDate DateTime? 
  disableCheckIn  Boolean  @default(false) 
  dietGoal        String   @default("NONE") 
  goal            String?
  level           String?
  isMenstruating  Boolean   @default(false)
  menstruationStartDate DateTime?

  strategyNotes   String?   @db.Text
  lastContactDate DateTime?
  weeklyChecks    Json?

  dietModule       Boolean  @default(false)
  anamnesePendente Boolean  @default(false) 

  runningModule   Boolean  @default(false)

  createdAt       DateTime @default(now())

  coachId         String?
  coach           User?    @relation("CoachStudents", fields: [coachId], references: [id], onDelete: SetNull)
  students        User[]   @relation("CoachStudents")

  nutritionistId  String?
  nutritionist    User?    @relation("NutritionistStudents", fields: [nutritionistId], references: [id], onDelete: SetNull)
  dietStudents    User[]   @relation("NutritionistStudents")

  createdExercises  Exercise[]          @relation("CoachExercises")
  createdTemplates  WorkoutTemplate[]   @relation("CoachTemplates")
  createdNotices    Notice[]            @relation("CoachNotices")
  createdContents   Content[]           @relation("CoachContents")
  createdContentCategories ContentCategory[] @relation("CoachContentCategories")
  createdCollections TemplateCollection[] @relation("CoachCollections")
  createdTechniques Technique[]         @relation("CoachTechniques") 

  createdMotorTemplates MotorTemplate[] @relation("CoachMotorTemplates")

  offlineClients    OfflineClient[]     @relation("CoachOfflineClients")

  workouts        Workout[]
  anamneses       Anamnese[]
  history         WorkoutHistory[] 
  assessments     Assessment[]       
  checkIns        CheckIn[]
  diets           Diet[]

  runningAnamnese   RunningAnamnese?
  runningProtocols  RunningProtocol[]
  runningLogs       RunningLog[] 
  
  contentLikes      ContentLike[]
  contentComments   ContentComment[]
  contentCompletions ContentCompletion[] 
  unlockedContents  ContentAccess[]     

  surveys           SatisfactionSurvey[]

  resetToken       String?
  resetTokenExpiry DateTime?

  alertsAsStudent   StudentAlert[] @relation("UserAlerts")
  alertsAsCoach     StudentAlert[] @relation("CoachAlerts")

  brandLogoSize  Int?     @default(220) 

  salesPageConfig   SalesPageConfig?
  coachPlans        CoachPlan[]         @relation("CoachPlans")

  manualReceipts    ManualReceipt[]     @relation("CoachManualReceipts")

  // 🔥 (19 set 2026) Substituindo o campo webPushSubscription (Json? acima —
  // mantido só por compatibilidade, não usado mais em código novo) por uma
  // relação 1-pra-N: cada NAVEGADOR/DISPOSITIVO em que o usuário autoriza
  // notificação vira uma linha própria aqui. Antes, um usuário só podia ter
  // UMA assinatura salva por vez — ativar notificação no PC sobrescrevia a
  // do celular (e vice-versa), então um dos dois parava de receber avisos
  // sem nenhum erro visível. Ver app/api/user/web-push-subscription e
  // app/utils/sendNotification.ts.
  webPushSubscriptions WebPushSubscription[]
}

model WebPushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model OfflineClient {
  id              String    @id
  name            String
  phone           String?
  plan            String?
  financeCategory String?   @default("Consultoria Online")
  contractType    String?   @default("Mensal")
  contractValue   Float?    @default(0.0)
  startDate       DateTime?
  paymentDueDate  DateTime?
  photoUrl        String?
  isFinanceActive Boolean   @default(true)
  assignedCoach   String?   

  coachId         String?
  coach           User?     @relation("CoachOfflineClients", fields: [coachId], references: [id], onDelete: Cascade)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model AiLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  question  String
  answer    String
  createdAt DateTime @default(now())
}

model StudentAlert {
  id           String   @id @default(uuid())
  
  userId       String
  user         User     @relation("UserAlerts", fields: [userId], references: [id], onDelete: Cascade)
  
  coachId      String?
  coach        User?    @relation("CoachAlerts", fields: [coachId], references: [id], onDelete: Cascade)

  type         String   
  title        String   
  message      String   @db.Text 
  exerciseName String?  
  
  isRead       Boolean  @default(false) 
  createdAt    DateTime @default(now())
}